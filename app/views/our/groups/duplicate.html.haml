- content_for(:title) { "Duplicate #{@group.name} — Plural Profiles" }

.card
  .card__header
    - if @group.avatar.attached?
      = image_tag @group.avatar.variant(resize_to_fill: [96, 96]), class: "avatar avatar--large #{avatar_shape_class(@group)}".strip, width: 96, height: 96, alt: @group.avatar_alt_text.presence || "", loading: "lazy"
    - else
      .avatar.avatar--large.avatar--placeholder
        = render "shared/plural_pride_logo"

    %div
      .name-with-labels
        %h1= @group.name
        - if @group.labels.any?
          .label-badges
            - @group.labels.each do |label|
              %span.label-badge= label

      - if @group.subtitle.present?
        %p.subtitle= @group.subtitle

  %h2 Duplicate group
  %p
    Duplicate
    %strong= @group.name
    and its entire tree of sub-groups and profiles. Every new copy will be
    given the labels you specify below.

  = form_with url: duplicate_scan_our_group_path(@group), method: :post do |form|
    .form-group
      = form.label :labels_text, "Labels for all copies (private, comma-separated)"
      = form.text_field :labels_text, placeholder: "e.g. work, public"
      %p.form-hint At least one label is required so copies can be identified.

    .profile-actions
      = link_to "Cancel", our_group_path(@group), class: "btn btn--secondary"
      = form.submit "Next", class: "btn"
