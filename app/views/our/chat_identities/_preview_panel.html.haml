-# Locals:
-#   postable — a Profile or Group, possibly carrying unsaved in-memory
-#              attribute changes (from the live-preview fetch, once step 6
-#              wires it up) — read exclusively through chat_* resolvers,
-#              same as chat/mini_profiles/_mini_profile.
-#
-# Rendered both by the edit page itself (initial, server-rendered state)
-# and by Our::ChatIdentitiesController#preview (same partial, unsaved
-# in-progress form values) — one source of truth for both.

- has_pronouns = postable.respond_to?(:chat_pronouns) && postable.chat_pronouns.present?

.preview-block
  .preview-block__body
    = render "chat/mini_profiles/mini_profile", postable: postable, own: true

.preview-block
  .preview-block__body
    .chat-message
      .chat-message__avatar
        - avatar = chat_avatar_for(postable)
        - if avatar.attached?
          = image_tag avatar.variant(resize_to_fill: [34, 34]), class: "avatar #{avatar_shape_class(postable, shape: "circle")}".strip, width: 34, height: 34, alt: "", loading: "lazy"
        - else
          .avatar.avatar--placeholder.avatar--circle
            = render "shared/plural_pride_logo"
      .chat-message__content
        .chat-message__who
          %span.chat-message__name= formatted_inline(postable.chat_name)
          - if has_pronouns
            %span.chat-message__pronouns= formatted_inline(postable.chat_pronouns)
          %time.chat-message__time= Time.current.strftime("%H:%M")
        - if postable.chat_subtitle.present?
          %span.chat-message__subtitle= formatted_inline(postable.chat_subtitle)
        .chat-message__body hi, how are you doing?
