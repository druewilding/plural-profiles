.theme-row{ class: ("theme-row--active" if Current.user.active_theme_id == theme.id), data: { theme_id: theme.id, theme_section: local_assigns[:section] } }
  .theme-row__info
    .theme-row__name-line
      %h3= link_to theme.name, our_theme_path(theme)
      - if Current.user.active_theme_id == theme.id
        %span.tag.tag--active Active
    - if theme.credit.present? || theme.credit_url.present?
      %p.theme-row__credit
        Made by
        - if theme.credit.present? && theme.credit_url.present?
          %strong= link_to theme.credit, theme.credit_url, target: "_blank", rel: "noopener noreferrer"
        - elsif theme.credit.present?
          %strong= theme.credit
        - elsif theme.credit_url.present?
          %strong= link_to theme.credit_url, theme.credit_url, target: "_blank", rel: "noopener noreferrer"
    - if theme.notes.present?
      %p.theme-row__notes= theme.notes
    - if theme.tags.any? || (theme.shared? && theme.site_default?)
      .theme-row__tags
        - if theme.shared? && theme.site_default?
          %span.tag.tag--default Default theme
        - theme.tags.each do |tag|
          %span.tag.tag--theme= Theme::TAGS[tag] || tag

  .theme-row__end
    .theme-swatches{aria: { hidden: "true" }}
      - theme.swatch_colors.each do |color|
        %span.theme-swatches__dot{style: "background-color: #{color}"}

    %details.action-dropdown{data: { controller: "dropdown" }}
      %summary.action-dropdown__trigger{aria: { label: "Actions for #{theme.name}" }}
        Options
      .action-dropdown__menu
        - if Current.user.active_theme_id == theme.id
          = link_to "Deactivate", deactivate_our_themes_path, data: { turbo_method: :patch }, class: "action-dropdown__item"
        - else
          = link_to "Activate", activate_our_theme_path(theme), data: { turbo_method: :patch }, class: "action-dropdown__item"
        - if theme.shared?
          = link_to "Preview", our_theme_path(theme), class: "action-dropdown__item"
        - if !theme.shared? || Current.user.admin?
          = link_to "Edit", edit_our_theme_path(theme), class: "action-dropdown__item"
        = link_to "Duplicate", duplicate_our_theme_path(theme), data: { turbo_method: :post }, class: "action-dropdown__item"
        - if Current.user.admin? && theme.shared?
          %hr.action-dropdown__divider
          - if theme.site_default?
            = link_to "Remove default", set_default_our_theme_path(theme), data: { turbo_method: :patch }, class: "action-dropdown__item"
          - else
            = link_to "Make default", set_default_our_theme_path(theme), data: { turbo_method: :patch }, class: "action-dropdown__item"
        - unless theme.shared?
          %hr.action-dropdown__divider
          = link_to "Delete", our_theme_path(theme), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this theme?" }, class: "action-dropdown__item action-dropdown__item--danger"
