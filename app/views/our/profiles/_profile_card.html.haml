.card.profile-card
  - if profile.avatar.attached?
    = image_tag profile.avatar.variant(resize_to_fill: [64, 64]), class: "avatar #{avatar_shape_class(profile)}".strip, width: 64, height: 64, alt: profile.avatar_alt_text.presence || "", loading: "lazy"
  - else
    .avatar.avatar--placeholder
      = render "shared/plural_pride_logo"
  %h3
    = link_to our_profile_path(profile) do
      = formatted_inline(profile.name)
  - if profile.subtitle.present?
    %p.subtitle= formatted_inline(profile.subtitle)
  - if profile.labels.any?
    .label-badges
      - profile.labels.each do |label|
        %span.label-badge= label
  - if profile.pronouns.present?
    %span.pronouns= formatted_inline(profile.pronouns)
  - if profile.tag_line.present?
    %p.tag-line= formatted_inline(profile.tag_line)
  - if local_assigns[:action_label]
    .profile-card__action-spacer
    = link_to action_label, action_path, data: ({ turbo_method: action_method } if local_assigns[:action_method]), class: local_assigns.fetch(:action_class, "btn btn--small")
