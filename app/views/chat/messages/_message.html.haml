.chat-message{id: dom_id(message)}
  .chat-message__avatar
    - if message.postable&.avatar&.attached?
      = image_tag message.postable.avatar.variant(resize_to_fill: [34, 34]), class: "avatar #{avatar_shape_class(message.postable, shape: "circle")}".strip, width: 34, height: 34, alt: "", loading: "lazy"
    - else
      .avatar.avatar--placeholder.avatar--circle
        = render "shared/plural_pride_logo"

  .chat-message__content
    .chat-message__who
      - if message.postable
        = link_to chat_postable_url(message.postable), class: "chat-message__name-link" do
          %span.chat-message__name= formatted_inline(message.postable.name)
        - if message.postable.respond_to?(:pronouns) && message.postable.pronouns.present?
          %span.chat-message__pronouns= formatted_inline(message.postable.pronouns)
      - else
        %span.chat-message__name.chat-message__name--deleted= "#{message.postable_name} (deleted)"
      %time.chat-message__time{datetime: message.created_at.iso8601}= message.created_at.strftime("%H:%M")

    - if message.postable&.subtitle&.present?
      %span.chat-message__subtitle= formatted_inline(message.postable.subtitle)

    .chat-message__body{style: "white-space: pre-wrap"}= formatted_inline(message.body)
