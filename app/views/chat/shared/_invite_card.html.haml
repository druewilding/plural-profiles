.invite-card
  = render "chat/shared/avatar", record: server, size: 64
  %h2.invite-card__title= safe_join([ "Join ", formatted_inline(server.name), "?" ])
  - if server.subtitle.present?
    %p.subtitle= formatted_inline(server.subtitle)
  - if server.description.present?
    %p.invite-card__description= formatted_inline(server.description)
  - if preview
    %span.btn.btn--primary.invite-card__accept-preview Accept invite
  - else
    = link_to "Accept invite", join_chat_server_path(server, invite_token: invite_token), class: "btn btn--primary"
  %p.form-hint You'll choose which of your profiles to post as once you're in.
