.channel-pane
  = link_to formatted_inline(@server.name), chat_server_path(@server), class: "channel-pane__server-name"

  %ul.sidebar-tree__children
    - @server.channels.order(:name).each do |channel|
      %li
        = link_to safe_join([ "# ", formatted_inline(channel.name) ]), chat_server_channel_path(@server, channel), class: "sidebar-tree__leaf #{'sidebar-tree__leaf--active' if params[:uuid] == channel.uuid}".strip

  - if server_owner?
    = link_to "+ Add channel", new_chat_server_channel_path(@server), class: "channel-pane__add-channel"
