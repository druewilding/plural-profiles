- content_for(:title) { "# #{plain_field(@channel.name)} — #{@server.name} — Plural Profiles" }

.chat-channel{data: {controller: "chat-scroll channel-read", "channel-read-url-value": mark_read_chat_server_channel_path(@server, @channel)}}
  .chat-channel-header
    %div
      %h1= safe_join([ "# ", formatted_inline(@channel.name) ])
      - if @channel.subtitle.present?
        %p.subtitle= formatted_inline(@channel.subtitle)

    - if server_owner?
      = link_to "Channel settings", edit_chat_server_channel_path(@server, @channel), class: "btn btn--secondary"

  = turbo_stream_from @channel

  .chat-messages-scroll{data: {"chat-scroll-target": "scrollable"}}
    #chat-messages.chat-messages{data: {"chat-scroll-target": "messages"}}
      - if @has_more_messages
        %turbo-frame#older-messages{src: chat_server_channel_messages_path(@server, @channel, before_id: @messages.first.id, before_created_at: @messages.first.created_at.iso8601(6)), loading: "lazy"}
      - if @messages.any?
        = render "chat/messages/message_list", messages: @messages
      - else
        %p No messages yet. Say hello!

  .composer{data: {controller: "composer"}}
    - if current_membership&.default_profile
      - current_profile = @channel.default_profile_for(Current.user) || current_membership.default_profile
      %details.action-dropdown.composer-posting-as{data: {controller: "dropdown"}}
        %summary.composer-posting-as__trigger
          %span.composer-posting-as__trigger-avatar{data: {"composer-target": "triggerAvatar"}}
            = render "chat/shared/avatar", record: current_profile, size: 22
          %span
            Posting as
            %strong{data: {"composer-target": "triggerName"}}= formatted_inline(current_profile.name)
        .action-dropdown__menu.composer-posting-as__menu{data: {controller: "profile-filter"}}
          %input.composer-posting-as__search{type: "text", autocomplete: "off", placeholder: "Find a profile…", "aria-label": "Filter profiles", data: {"profile-filter-target": "input", action: "input->profile-filter#apply"}}
          .composer-posting-as__options{data: {"profile-filter-target": "list"}}
            - Current.user.profiles.order(:name).includes(avatar_attachment: :blob).each do |profile|
              - search_text = plain_field([profile.name, profile.pronouns, profile.subtitle, profile.labels.join(" ")].compact.join(" ")).downcase
              - option_class = "action-dropdown__item composer-posting-as__option#{' composer-posting-as__option--current' if profile == current_profile}"
              - proxy_prefix, proxy_suffix = profile.chat_brackets.present? ? profile.chat_brackets.split("text", 2) : [ "", "" ]
              = link_to chat_server_channel_default_profile_path(@server, @channel, profile_uuid: profile.uuid), class: option_class, data: { turbo_method: :patch, "profile-filter-target": "option", "composer-target": "option", search: search_text, prefix: proxy_prefix, suffix: proxy_suffix.to_s } do
                = render "chat/shared/avatar", record: profile, size: 20
                .composer-posting-as__option-info
                  .composer-posting-as__option-name-row
                    %span.composer-posting-as__option-name= formatted_inline(profile.name)
                    - if profile.pronouns.present?
                      %span.composer-posting-as__option-pronouns= formatted_inline(profile.pronouns)
                  - if profile.subtitle.present?
                    %span.composer-posting-as__option-subtitle= formatted_inline(profile.subtitle)
                  - if profile.labels.any?
                    .label-badges
                      - profile.labels.each do |label|
                        %span.label-badge.label-badge--sidebar= label
            %p.composer-posting-as__empty{data: {"profile-filter-target": "empty"}, hidden: true} No profiles match your search.

    = form_with model: @message, url: chat_server_channel_messages_path(@server, @channel), scope: :chat_message, data: { "composer-target": "form" } do |form|
      - if @message.errors.any?
        .error-messages
          - @message.errors.full_messages.each do |message|
            %p= message

      .composer-input-row
        = form.text_area :body, rows: 2, required: true, autofocus: true, placeholder: "Message ##{plain_field(@channel.name)} (Enter to send, Shift+Enter for a new line)", data: { "composer-target": "textarea", action: "keydown->composer#submitOnEnter input->composer#detectProxy" }
        = form.submit "Send", class: "visually-hidden"
