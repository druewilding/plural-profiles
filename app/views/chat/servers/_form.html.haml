- if server.errors.any?
  .error-messages
    - server.errors.full_messages.each do |message|
      %p= message

= form_with model: server, url: server.persisted? ? chat_server_path(server) : chat_servers_path, scope: :chat_server do |form|
  .form-group
    = render "shared/avatar_editor_dialog", record: server, form: form, param_prefix: "chat_server"

  .form-group
    = form.label :name
    = form.text_field :name, required: true, "data-1p-ignore": "true"

  .form-group
    = form.label :subtitle
    = form.text_field :subtitle

  .form-group
    = form.label :theme_id, "Display theme"
    = form.select :theme_id, grouped_options_for_select(grouped_theme_options(@our_themes, @shared_themes), server.theme_id), { include_blank: "None (use default)" }, {}
    %p.form-hint Members of this server will see this theme, unless a channel overrides it. Leave blank for the site default.

  - unless server.persisted?
    - our_profiles = Current.user.profiles.order(:name)
    - our_groups = Current.user.groups.order(:name)
    .form-group
      %label{id: "chat_server_default_postable_label"} Post as
      = render "chat/shared/profile_picker", field_name: "chat_server[default_postable]", label_id: "chat_server_default_postable_label", profiles: our_profiles, groups: our_groups, selected_postable: our_profiles.first
      %p.form-hint The profile or group you'll post as by default in this server. You can change this any time.

  .form-group
    = form.submit server.persisted? ? "Update server" : "Create server"
    = link_to "Cancel", server.persisted? ? chat_server_path(server) : chat_servers_path, class: "btn btn--secondary"
