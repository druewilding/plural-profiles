- content_for(:title) { "Stats — Plural Profiles" }

%h1 Stats

%h2 General
.stats-grid
  .card.stats-card
    .stats-card__number= @user_count
    .stats-card__label Accounts
  .card.stats-card
    .stats-card__number= @group_count
    .stats-card__label Groups
  .card.stats-card
    .stats-card__number= @profile_count
    .stats-card__label Profiles
  .card.stats-card
    .stats-card__number= @invite_code_count
    .stats-card__label Unused invite codes
  .card.stats-card
    .stats-card__number= @theme_count
    .stats-card__label Themes

%h2 Avatars
.stats-grid
  .card.stats-card
    .stats-card__number= @group_avatar_count
    .stats-card__label Group avatars
  .card.stats-card
    .stats-card__number= @profile_avatar_count
    .stats-card__label Profile avatars
  .card.stats-card
    .stats-card__number= @server_avatar_count
    .stats-card__label Server avatars

%h2 Chat
.stats-grid
  .card.stats-card
    .stats-card__number= @chat_server_count
    .stats-card__label Servers
  .card.stats-card
    .stats-card__number= @chat_channel_count
    .stats-card__label Channels
  .card.stats-card
    .stats-card__number= @chat_membership_count
    .stats-card__label Memberships
  .card.stats-card
    .stats-card__number= @chat_message_count
    .stats-card__label Messages
  .card.stats-card
    .stats-card__number= @chat_server_invite_count
    .stats-card__label Unused server invites
