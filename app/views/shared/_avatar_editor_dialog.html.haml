-# Locals:
-#   record             — the Profile, Group, or Chat::Server instance
-#   form               — the form_with builder object
-#   param_prefix       — top-level param key of the form (e.g. "profile",
-#                        "group", "chat_identity") — used for the
-#                        remove_<attribute> checkbox name, which isn't
-#                        mass-assigned so it isn't a real form.check_box on
-#                        the model.
-#   attribute          — (optional, default "avatar") the has_one_attached
-#                        name to edit — "avatar" or "mini_profile_avatar".
-#                        Its paired "<attribute>_shape"/"<attribute>_alt_text"
-#                        columns are driven off this too, so a second
-#                        instance of this dialog edits a fully independent
-#                        avatar/shape/alt-text trio.
-#   fallback_attachment, fallback_shape, fallback_alt_text — (all optional)
-#                        shown instead of the empty placeholder when
-#                        `attribute` itself isn't attached — e.g. the main
-#                        avatar, for the mini-profile avatar instance, which
-#                        effectively inherits it until something's uploaded
-#                        here specifically. Purely cosmetic: doesn't affect
-#                        the "Add"/"Edit" button copy or whether "Remove"
-#                        shows, which are always about `attribute` itself.
-#   label              — (optional, default "avatar") human name used in the
-#                        dialog title ("Add #{label}"/"Edit #{label}") and
-#                        the alt-text field's label ("#{label} description").
-#   trigger_label      — (optional) fixed text for the outer trigger button,
-#                        overriding the default "Add avatar"/"Edit avatar"
-#                        distinction — used where the surrounding UI (e.g. a
-#                        "Use main"/"Set for chat" toggle) already
-#                        communicates add-vs-edit, so the button can just
-#                        say what it does ("Set chat avatar").
-#
-# Must be rendered inside a form_with block. The <dialog> is a child of the
-# form element so all its inputs submit with the main form. Multiple
-# instances (different `attribute`s) can be rendered in the same form —
-# each gets its own data-controller="avatar-editor" scope, so Stimulus
-# targets never collide between them.

- attribute ||= "avatar"
- attachment = record.public_send(attribute)
- shape_attribute = "#{attribute}_shape"
- alt_text_attribute = "#{attribute}_alt_text"
- label = local_assigns[:label] || "avatar"
- trigger_label = local_assigns[:trigger_label]

- if attachment.attached?
  - displayed_attachment = attachment
  - displayed_shape = record.public_send(shape_attribute)
  - displayed_alt_text = record.public_send(alt_text_attribute)
- else
  - displayed_attachment = local_assigns[:fallback_attachment]
  - displayed_shape = local_assigns[:fallback_shape]
  - displayed_alt_text = local_assigns[:fallback_alt_text]
- displayed = displayed_attachment&.attached? || false

.avatar-editor{data: {controller: "avatar-editor"}}
  .avatar-editor__current
    - if displayed
      = image_tag displayed_attachment.variant(resize_to_fill: [64, 64]),
                  class: "avatar #{avatar_shape_class(record, shape: displayed_shape)}".strip,
                  width: 64,
                  height: 64,
                  alt: displayed_alt_text.presence || "",
                  loading: "lazy",
                  data: {"avatar-editor-target": "mainPreview"}
      .avatar.avatar--placeholder{hidden: true, data: {"avatar-editor-target": "mainPlaceholder"}}
        = render "shared/plural_pride_logo"
    - else
      %img.avatar{width: 64, height: 64, alt: "", hidden: true, src: "",
                  data: {"avatar-editor-target": "mainPreview"}}
      .avatar.avatar--placeholder{data: {"avatar-editor-target": "mainPlaceholder"}}
        = render "shared/plural_pride_logo"

    %button.btn.btn--secondary{type: "button", data: {action: "click->avatar-editor#open"}}
      - if trigger_label
        = trigger_label
      - elsif attachment.attached?
        = "Edit #{label}"
      - else
        = "Add #{label}"

  %dialog.avatar-editor-dialog{open: true, data: {"avatar-editor-target": "dialog"}}
    %h2.avatar-editor-dialog__title
      - if attachment.attached?
        = "Edit #{label}"
      - else
        = "Add #{label}"

    .avatar-editor-dialog__preview
      - if displayed
        = image_tag displayed_attachment.variant(resize_to_fill: [96, 96]),
                    class: "avatar avatar--large #{avatar_shape_class(record, shape: displayed_shape)}".strip,
                    width: 96,
                    height: 96,
                    alt: "",
                    loading: "lazy",
                    data: {"avatar-editor-target": "dialogPreview"}
        .avatar.avatar--large.avatar--placeholder{hidden: true, data: {"avatar-editor-target": "dialogPlaceholder"}}
          = render "shared/plural_pride_logo"
      - else
        %img.avatar.avatar--large{width: 96, height: 96, alt: "", hidden: true, src: "",
                                  data: {"avatar-editor-target": "dialogPreview"}}
        .avatar.avatar--large.avatar--placeholder{data: {"avatar-editor-target": "dialogPlaceholder"}}
          = render "shared/plural_pride_logo"

    .form-group
      = form.label attribute, "New image (up to 2 MB)"
      = form.file_field attribute,
                        accept: "image/jpeg, image/png, image/webp",
                        data: {"avatar-editor-target": "fileInput",
                               action: "change->avatar-editor#onFileChange"}

    .form-group
      %label Shape
      .avatar-shape-picker
        - HasAvatar::AVATAR_SHAPES.each do |shape|
          %label.avatar-shape-picker__option
            = form.radio_button shape_attribute, shape,
                                data: {"avatar-editor-target": "shapeInput",
                                       action: "change->avatar-editor#onShapeChange"}
            .avatar-shape-picker__sample{"class" => "avatar-shape-picker__sample--#{shape}"}
            = shape.capitalize

    .form-group
      = form.label alt_text_attribute, "#{label.capitalize} description"
      = form.text_field alt_text_attribute,
                        placeholder: "Describe the image for screen readers",
                        data: {"avatar-editor-target": "altTextField"}

    - if record.persisted? && attachment.attached?
      .form-group
        %label.checkbox-label
          = check_box_tag "#{param_prefix}[remove_#{attribute}]",
                          "1",
                          false,
                          data: {"avatar-editor-target": "removeCheckbox",
                                 action: "change->avatar-editor#onRemoveChange"}
          Remove avatar

    .avatar-editor-dialog__actions
      %button.btn{type: "button", data: {action: "click->avatar-editor#close"}} Done
      %button.btn.btn--secondary{type: "button", data: {action: "click->avatar-editor#cancel"}} Cancel
