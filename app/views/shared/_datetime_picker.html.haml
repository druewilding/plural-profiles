-# Locals:
-#   form  — the form_with builder object
-#   field — the attribute symbol (e.g. :created_at) — submits as "#{form.object_name}[#{field}_parts][month/day/year/hour/minute]"
-#   value — a Time/ActiveSupport::TimeWithZone already in the viewer's time zone
-#
-# Month/Day/Hour/Minute are real <select> dropdowns (bounded ranges, and this
-# gives them the exact same native arrow as every other select in the app —
-# no custom indicator to keep in sync across browsers). Year is unbounded, so
-# it stays a numeric input with no range limit. Works with no JS: plain form
-# fields, and the server (see profile_params/group_params) tolerantly parses
-# the month as a name or a number.

.datetime-picker
  .datetime-picker__field.datetime-picker__field--month
    %label.visually-hidden{for: "#{field}_month"} Month
    %select{id: "#{field}_month", name: "#{form.object_name}[#{field}_parts][month]"}
      = options_for_select(Date::MONTHNAMES.compact, value.strftime("%B"))

  .datetime-picker__field.datetime-picker__field--day
    %label.visually-hidden{for: "#{field}_day"} Day
    %select{id: "#{field}_day", name: "#{form.object_name}[#{field}_parts][day]"}
      = options_for_select((1..31).to_a, value.day)

  .datetime-picker__field.datetime-picker__field--year
    %label.visually-hidden{for: "#{field}_year"} Year
    %input{type: "number", id: "#{field}_year", name: "#{form.object_name}[#{field}_parts][year]", value: value.year, autocomplete: "off"}

  .datetime-picker__field.datetime-picker__field--hour
    %label.visually-hidden{for: "#{field}_hour"} Hour
    %select{id: "#{field}_hour", name: "#{form.object_name}[#{field}_parts][hour]"}
      = options_for_select((0..23).to_a, value.hour)

  %span.datetime-picker__separator :

  .datetime-picker__field.datetime-picker__field--minute
    %label.visually-hidden{for: "#{field}_minute"} Minute
    %select{id: "#{field}_minute", name: "#{form.object_name}[#{field}_parts][minute]"}
      = options_for_select((0..59).to_a, value.min)

%p.form-hint (24 hour time)
