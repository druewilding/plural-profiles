-# Locals:
-#   form  — the form_with builder object
-#   field — the attribute symbol (e.g. :created_at) — submits as "#{form.object_name}[#{field}_parts][month/day/year/hour/minute]"
-#   value — a Time/ActiveSupport::TimeWithZone already in the viewer's time zone
-#
-# Plain text inputs paired with <datalist> suggestions — works with no JS (the
-# browser filters suggestions natively), and the server (see profile_params /
-# group_params) tolerantly parses month names or numbers, so typing "June" or
-# "6" both work.

.datetime-picker
  .datetime-picker__field.datetime-picker__field--month
    %label.visually-hidden{for: "#{field}_month"} Month
    %input{type: "text", id: "#{field}_month", name: "#{form.object_name}[#{field}_parts][month]", value: value.strftime("%B"), list: "#{field}_month_options", autocomplete: "off"}
    %datalist{id: "#{field}_month_options"}
      - Date::MONTHNAMES.compact.each do |name|
        %option{value: name}

  .datetime-picker__field.datetime-picker__field--day
    %label.visually-hidden{for: "#{field}_day"} Day
    %input{type: "text", inputmode: "numeric", id: "#{field}_day", name: "#{form.object_name}[#{field}_parts][day]", value: value.day, list: "#{field}_day_options", autocomplete: "off"}
    %datalist{id: "#{field}_day_options"}
      - (1..31).each do |day|
        %option{value: day}

  .datetime-picker__field.datetime-picker__field--year
    %label.visually-hidden{for: "#{field}_year"} Year
    %input{type: "text", inputmode: "numeric", id: "#{field}_year", name: "#{form.object_name}[#{field}_parts][year]", value: value.year, autocomplete: "off"}

  .datetime-picker__field.datetime-picker__field--hour
    %label.visually-hidden{for: "#{field}_hour"} Hour
    %input{type: "text", inputmode: "numeric", id: "#{field}_hour", name: "#{form.object_name}[#{field}_parts][hour]", value: value.hour, list: "#{field}_hour_options", autocomplete: "off"}
    %datalist{id: "#{field}_hour_options"}
      - (0..23).each do |hour|
        %option{value: hour}

  %span.datetime-picker__separator :

  .datetime-picker__field.datetime-picker__field--minute
    %label.visually-hidden{for: "#{field}_minute"} Minute
    %input{type: "text", inputmode: "numeric", id: "#{field}_minute", name: "#{form.object_name}[#{field}_parts][minute]", value: value.min, list: "#{field}_minute_options", autocomplete: "off"}
    %datalist{id: "#{field}_minute_options"}
      - (0..59).each do |minute|
        %option{value: minute}

%p.form-hint (24 hour time)
